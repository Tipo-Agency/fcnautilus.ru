# Пример конфигурации nginx для SPA с HashRouter
# Скопируйте этот файл в /etc/nginx/sites-available/new.fcnautilus.ru
# И создайте симлинк: ln -s /etc/nginx/sites-available/new.fcnautilus.ru /etc/nginx/sites-enabled/

server {
    listen 80;
    listen [::]:80;
    server_name new.fcnautilus.ru;

    # Редирект на HTTPS (если используется SSL)
    # return 301 https://$server_name$request_uri;

    root /var/www/new.fcnautilus.ru;  # Укажите ваш SERVER_PATH
    index index.html;

    # Логи
    access_log /var/log/nginx/new.fcnautilus.ru.access.log;
    error_log /var/log/nginx/new.fcnautilus.ru.error.log;

    # Основная локация - для HashRouter все запросы должны отдавать index.html
    # ВАЖНО: для HashRouter (#/path) это должно работать, так как браузер не отправляет # на сервер
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Кеширование статических файлов
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Безопасность
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;

    # Gzip
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml text/javascript application/x-javascript application/xml+rss application/javascript application/json;
}

# Если используется HTTPS, раскомментируйте и настройте:
# server {
#     listen 443 ssl http2;
#     listen [::]:443 ssl http2;
#     server_name new.fcnautilus.ru;
#
#     ssl_certificate /path/to/certificate.crt;
#     ssl_certificate_key /path/to/private.key;
